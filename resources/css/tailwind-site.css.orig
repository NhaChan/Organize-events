@layer theme, components, utilities;
@import "tailwindcss/theme.css" layer(theme);
@import "tailwindcss/utilities.css" layer(utilities);

@theme {
    --font-sans: "Roboto", ui-sans-serif, system-ui, sans-serif;
    --font-display: "Roboto", ui-sans-serif, system-ui, sans-serif;
    --color-party-ink: #18233a;
    --color-party-muted: #68738a;
    --color-party-pink: #ff5d8f;
    --color-party-orange: #ff9f43;
    --color-party-cyan: #34c8d8;
}
@layer components {
:root{@apply [--ink:#18233a] [--muted:#68738a] [--pink:#ff5d8f] [--orange:#ff9f43] [--yellow:#ffd166] [--cyan:#34c8d8] [--blue:#4b7bec] [--purple:#8b5cf6] [--line:#e8edf4] [--soft:#f8fbff];}
*{@apply [box-sizing:border-box];}
html{@apply [scroll-behavior:smooth];}
body{@apply [margin:0] [font-family:Roboto,sans-serif] [color:var(--ink)] [background:#fff];}
a{@apply [text-decoration:none] [color:inherit];}
h1,h2,h3,.brand{@apply [font-family:Roboto,sans-serif];}
.site-header{@apply [height:76px] [position:sticky] [top:0] [z-index:100] [background:rgba(255,255,255,.95)] [backdrop-filter:blur(14px)] [border-bottom:1px_solid_var(--line)];}
.site-nav{@apply [max-width:1180px] [height:100%] [margin:auto] [padding:0_24px] [display:flex] [align-items:center] [justify-content:space-between];}
.brand{@apply [display:flex] [align-items:center] [gap:10px] [font-size:1.25rem] [font-weight:800] [line-height:1];}
.header-brand{@apply [flex:none] [width:clamp(205px,17vw,245px)] [line-height:0];}
.header-logo{@apply [display:block] [width:100%] [height:auto] [max-height:58px] [object-fit:contain] [object-position:left_center];}
.brand-mark{@apply [width:43px] [height:43px] [border-radius:14px] [background:linear-gradient(135deg,#ffe4ed,#fff0cb)] [display:grid] [place-items:center] [font-size:24px];}
.brand small{@apply [font-family:Roboto] [display:block] [color:var(--muted)] [font-size:.62rem] [letter-spacing:.08em] [margin-top:5px];}
.main-nav{@apply [display:flex] [align-items:center] [gap:8px];}
.main-nav a{@apply [padding:9px_13px] [font-size:.9rem] [font-weight:700] [color:#46516a] [border-radius:10px];}
.main-nav a:hover{@apply [color:var(--pink)] [background:#fff1f5];}
.main-nav .nav-contact{@apply [color:#fff] [background:linear-gradient(135deg,var(--pink),#ff7b6b)] [box-shadow:0_7px_20px_#ff5d8f38];}
.menu-button{@apply [display:none] [border:0] [background:#fff1f5] [color:var(--pink)] [font-size:22px] [border-radius:9px] [padding:6px_10px];}
.party-hero{@apply [min-height:650px] [display:grid] [grid-template-columns:1.05fr_.95fr] [align-items:center] [gap:40px] [padding:80px_max(24px,calc((100vw_-_1180px)/2))] [overflow:hidden] [position:relative] [background:radial-gradient(circle_at_10%_20%,#ffe2ed_0,transparent_28%),radial-gradient(circle_at_85%_20%,#e1f9fc_0,transparent_30%),linear-gradient(145deg,#fffaf3,#fff_48%,#f3fdff)];}
.hero-copy{@apply [position:relative] [z-index:2];}
.eyebrow,.section-heading>span,.inner-hero>span,.contact-banner>div>span{@apply [color:var(--pink)] [font-weight:800] [font-size:.78rem] [letter-spacing:.13em];}
.hero-copy h1{@apply [font-size:clamp(3rem,6vw,5.2rem)] [line-height:.94] [margin:16px_0_22px] [letter-spacing:-.04em];}
.hero-copy h1 em{@apply [font-style:normal] [color:var(--pink)];}
.hero-copy>p{@apply [font-size:1.08rem] [line-height:1.75] [color:var(--muted)] [max-width:620px];}
.hero-buttons{@apply [display:flex] [gap:12px] [flex-wrap:wrap] [margin:30px_0];}
.party-btn{@apply [display:inline-flex] [align-items:center] [justify-content:center] [padding:13px_22px] [border-radius:13px] [font-weight:800];}
.party-btn.primary{@apply [color:#fff] [background:linear-gradient(135deg,var(--pink),#ff8268)] [box-shadow:0_10px_25px_#ff5d8f40];}
.party-btn.light{@apply [background:#fff] [border:1px_solid_var(--line)] [box-shadow:0_8px_25px_#25365b12];}
.party-btn.outline{@apply [border:2px_solid_var(--pink)] [color:var(--pink)] [background:#fff];}
.trust-row{@apply [display:flex] [gap:18px] [flex-wrap:wrap] [color:#526079] [font-size:.82rem] [font-weight:700];}
.hero-visual{@apply [min-height:480px] [position:relative] [display:grid] [place-items:center];}
.visual-card{@apply [width:min(390px,85%)] [aspect-ratio:1] [border-radius:50%_45%_48%_42%] [display:flex] [flex-direction:column] [align-items:center] [justify-content:center] [background:linear-gradient(145deg,#ffe4ed,#fff1c9)] [box-shadow:0_30px_70px_#ff6a8d2b] [transform:rotate(-3deg)];}
.visual-emoji{@apply [font-size:110px] [filter:drop-shadow(0_12px_14px_#ab647755)];}
.visual-card strong{@apply [font-family:Roboto] [font-size:1.65rem];}
.visual-card small{@apply [color:var(--muted)];}
.mini-card{@apply [position:absolute] [background:#fff] [padding:12px_17px] [border-radius:13px] [font-weight:800] [box-shadow:0_12px_35px_#24365520];}
.mini-card.magic{@apply [top:12%] [left:2%] [transform:rotate(-8deg)];}
.mini-card.music{@apply [right:0] [top:25%] [transform:rotate(7deg)];}
.mini-card.snack{@apply [bottom:10%] [left:7%] [transform:rotate(4deg)];}
.hero-bubbles i{@apply [position:absolute] [border-radius:50%] [opacity:.55];}
.hero-bubbles i:nth-child(1){@apply [width:30px] [height:30px] [background:var(--cyan)] [left:5%] [top:16%];}
.hero-bubbles i:nth-child(2){@apply [width:18px] [height:18px] [background:var(--yellow)] [left:46%] [top:12%];}
.hero-bubbles i:nth-child(3){@apply [width:42px] [height:42px] [border:5px_solid_#c7b7ff] [right:4%] [bottom:15%];}
.party-section{@apply [max-width:1180px] [margin:auto] [padding:24px_24px];}
.section-heading{@apply [text-align:center] [max-width:680px] [margin:0_auto_38px];}
.section-heading.left{@apply [text-align:left] [margin-left:0];}
.section-heading h2,.why-copy h2{@apply [font-size:clamp(2rem,4vw,3rem)] [line-height:1.08] [margin:9px_0_12px];}
.section-heading p,.why-copy>p{@apply [color:var(--muted)] [line-height:1.7];}
.service-grid{@apply [display:grid] [grid-template-columns:repeat(5,1fr)] [gap:16px];}
.service-card{@apply [min-height:225px] [padding:22px_18px] [overflow:hidden] [border:1px_solid_var(--line)] [border-radius:22px] [background:#fff] [box-shadow:0_8px_30px_#1d34570a] [transition:.2s];}
.service-card:hover{@apply [transform:translateY(-7px)] [box-shadow:0_18px_45px_#283c661a];}
.service-icon{@apply [width:56px] [height:56px] [display:grid] [place-items:center] [border-radius:17px] [font-size:29px] [margin-bottom:17px];}
.tone-1 .service-icon{@apply [background:#ffe6ef];}
.tone-2 .service-icon{@apply [background:#fff2d6];}
.tone-3 .service-icon{@apply [background:#e0f8fa];}
.tone-4 .service-icon{@apply [background:#ece8ff];}
.tone-5 .service-icon{@apply [background:#e5f4ff];}
.service-card h3{@apply [font-size:1.18rem] [margin:0_0_7px];}
.service-card p{@apply [font-size:.84rem] [line-height:1.55] [color:var(--muted)];}
.service-card>strong{@apply [font-size:.79rem] [color:var(--pink)];}
.center{@apply [text-align:center] [margin-top:34px];}
.why-section{@apply [max-width:none] [padding-left:max(24px,calc((100vw_-_1180px)/2))] [padding-right:max(24px,calc((100vw_-_1180px)/2))] [display:grid] [grid-template-columns:1fr_1fr] [gap:70px] [align-items:center] [background:#fff9f3];}
.photo-placeholder{@apply [min-height:460px] [border-radius:35px] [background:linear-gradient(145deg,#ffd4e2,#ffe7ad)] [display:flex] [flex-direction:column] [align-items:center] [justify-content:center] [font-size:120px] [box-shadow:18px_18px_0_#fff];}
.photo-placeholder span{@apply [font-size:1.1rem] [text-align:center] [font-weight:800];}
.benefit-list{@apply [display:grid] [gap:15px] [margin-top:28px];}
.benefit-list>div{@apply [display:flex] [gap:16px] [align-items:center] [background:#fff] [padding:14px] [border-radius:16px] [border:1px_solid_var(--line)];}
.benefit-list b{@apply [width:44px] [height:44px] [display:grid] [place-items:center] [border-radius:14px] [background:#fff0f5] [color:var(--pink)];}
.benefit-list span{@apply [display:flex] [flex-direction:column];}
.benefit-list small{@apply [color:var(--muted)] [margin-top:3px];}
.post-grid,.grid{@apply [display:grid] [grid-template-columns:repeat(3,1fr)] [gap:22px];}
.post-card{@apply [border:1px_solid_var(--line)] [border-radius:20px] [overflow:hidden] [background:#fff] [box-shadow:0_8px_30px_#1d34570c] [transition:.2s];}
.post-card:hover{@apply [transform:translateY(-5px)] [box-shadow:0_18px_45px_#283c661a];}
.post-image{@apply [display:grid] [place-items:center] [height:220px] [background:linear-gradient(135deg,#fff0f5,#fff5d9)] [position:relative] [font-size:70px] [overflow:hidden];}
.post-image img{@apply [width:100%] [height:100%] [object-fit:cover] [transition:.3s];}
.post-card:hover img{@apply [transform:scale(1.04)];}
.post-category{@apply [position:absolute] [left:14px] [bottom:14px] [background:#fff] [color:var(--pink)] [padding:5px_10px] [border-radius:20px] [font-size:.72rem] [font-weight:800];}
.post-body{@apply [padding:8px];}
.post-date{@apply [font-size:.72rem] [color:#929caf];}
.post-body h3{@apply [font-size:1.2rem] [line-height:1.2] [margin:8px_0];}
.post-body p{@apply [font-size:.85rem] [color:var(--muted)] [line-height:1.55];}
.read-more{@apply [color:var(--pink)] [font-size:.82rem] [font-weight:800];}
.contact-banner{@apply [margin:20px_max(24px,calc((100vw_-_1180px)/2))_80px] [padding:45px_50px] [border-radius:30px] [color:#fff] [background:linear-gradient(125deg,#ff5d8f,#ff8b5f_55%,#ffc34f)] [display:flex] [justify-content:space-between] [align-items:center] [gap:30px] [box-shadow:0_20px_55px_#ff6b7d30];}
.contact-banner h2{@apply [font-size:2rem] [margin:8px_0];}
.contact-banner p{@apply [margin:0] [opacity:.9];}
.contact-actions{@apply [display:flex] [gap:9px] [flex-wrap:wrap];}
.contact-actions a{@apply [background:#fff] [color:#d93f70] [padding:12px_17px] [border-radius:12px] [font-weight:800] [white-space:nowrap];}
.contact-banner.compact{@apply [margin-top:0];}
.inner-hero,.page-head{@apply [text-align:center] [padding:75px_24px] [background:linear-gradient(145deg,#fff1f5,#fff8e7_55%,#edfcff)];}
.inner-hero h1,.page-head h1{@apply [font-size:clamp(2.3rem,5vw,4rem)] [margin:8px_0];}
.inner-hero p,.page-head p{@apply [max-width:650px] [margin:auto] [color:var(--muted)];}
.service-page-grid{@apply [grid-template-columns:repeat(3,1fr)];}
.service-page-grid .service-card{@apply [min-height:280px];}
.service-image{@apply [display:block] [width:calc(100%_+_36px)] [height:150px] [border-radius:21px_21px_0_0] [object-fit:cover] [margin:-22px_-18px_18px];}
.service-meta{@apply [display:flex] [justify-content:space-between] [color:var(--muted)] [font-size:.76rem];}
.service-meta strong{@apply [color:var(--pink)];}
.wrap,.article{@apply [max-width:1000px] [margin:auto] [padding:55px_24px];}
.article h1{@apply [font-size:clamp(2.2rem,5vw,4rem)];}
.article .cover{@apply [width:100%] [max-height:650px] [object-fit:cover] [border-radius:22px] [margin:20px_0];}
.meta{@apply [color:var(--muted)];}
.lead{@apply [font-size:1.15rem] [font-weight:700] [line-height:1.65];}
.prose{@apply [line-height:1.85];}
.chips{@apply [display:flex] [gap:10px] [flex-wrap:wrap] [margin:18px_0_35px];}
.chips a{@apply [padding:9px_14px] [background:#fff0f5] [color:var(--pink)] [border-radius:20px] [font-weight:800];}
.event-actions{@apply [display:flex] [gap:12px] [margin-top:30px];}
.event-actions .btn,.btn-secondary{@apply [padding:12px_18px] [border-radius:12px] [font-weight:800] [background:var(--pink)] [color:#fff];}
.btn-secondary{@apply [background:#fff] [border:1px_solid_var(--pink)] [color:var(--pink)];}
.navigation-wrap{@apply [max-width:1180px] [margin:15px_auto_0] [padding:0_24px] [display:flex] [gap:15px] [align-items:center];}
.back-button{@apply [padding:8px_12px] [background:#fff] [border:1px_solid_var(--line)] [border-radius:9px];}
.breadcrumb{@apply [display:flex] [gap:7px] [flex-wrap:wrap] [color:var(--muted)] [font-size:.8rem];}
.empty-state{@apply [grid-column:1/-1] [text-align:center] [padding:50px] [border:2px_dashed_var(--line)] [border-radius:20px] [color:var(--muted)];}
.party-footer{@apply [background:#17223a] [color:#cdd5e3] [padding:60px_24px_20px];}
.footer-grid{@apply [max-width:1180px] [margin:auto] [display:grid] [grid-template-columns:1.5fr_1fr_1fr] [gap:60px];}
.footer-grid h3{@apply [color:#fff];}
.footer-grid>div>a:not(.brand),.footer-grid p{@apply [display:block] [margin:9px_0] [color:#aeb9cc] [font-size:.87rem];}
.footer-brand{@apply [color:#fff];}
.footer-bottom{@apply [max-width:1180px] [margin:35px_auto_0] [border-top:1px_solid_#ffffff18] [padding-top:20px] [font-size:.75rem] [color:#8492aa];}
.floating-contact{@apply [position:fixed] [right:18px] [bottom:20px] [z-index:90] [display:grid] [gap:9px];}
.floating-contact a{@apply [width:48px] [height:48px] [border-radius:50%] [display:grid] [place-items:center] [color:#fff] [font-weight:900] [box-shadow:0_8px_20px_#17223a35];}
.float-phone{@apply [background:#16a36a];}
.float-facebook{@apply [background:#1877f2] [font-family:Roboto] [font-size:24px];}
@media(max-width:1000px){
.service-grid{@apply [grid-template-columns:repeat(3,1fr)];}
.party-hero{@apply [grid-template-columns:1fr] [padding-top:60px];}
.hero-visual{@apply [min-height:380px];}
.why-section{@apply [grid-template-columns:1fr];}
.post-grid,.grid{@apply [grid-template-columns:repeat(2,1fr)];}
}
@media(max-width:720px){
.site-header{@apply [height:66px];}
.menu-button{@apply [display:block];}
.main-nav{@apply [display:none] [position:absolute] [top:66px] [left:12px] [right:12px] [background:#fff] [padding:10px] [border-radius:15px] [box-shadow:0_15px_40px_#26375028] [flex-direction:column] [align-items:stretch];}
.main-nav.open{@apply [display:flex];}
.party-hero{@apply [padding:55px_20px];}
.hero-copy h1{@apply [font-size:3rem];}
.hero-visual{@apply [min-height:300px];}
.visual-card{@apply [width:260px];}
.visual-emoji{@apply [font-size:75px];}
.service-grid,.service-page-grid,.post-grid,.grid{@apply [grid-template-columns:1fr];}
.party-section{@apply [padding:60px_20px];}
.contact-banner{@apply [margin:10px_16px_55px] [padding:30px_24px] [flex-direction:column] [align-items:flex-start];}
.footer-grid{@apply [grid-template-columns:1fr] [gap:25px];}
.why-section{@apply [padding:60px_20px];}
.photo-placeholder{@apply [min-height:330px];}
.trust-row{@apply [gap:8px];}
.trust-row span{@apply [width:100%];}
}
.home-hero{@apply [min-height:560px] [padding-top:58px] [padding-bottom:82px] [gap:64px] [background:radial-gradient(circle_at_8%_15%,#ffdce8_0,transparent_26%),radial-gradient(circle_at_90%_12%,#fff0c9_0,transparent_25%),linear-gradient(145deg,#fff9f5,#fff_56%,#fff5ec)];}
.home-hero .hero-copy h1{@apply [font-size:clamp(3.1rem,5.7vw,5rem)] [margin:14px_0_18px];}
.home-hero .hero-copy>p{@apply [max-width:570px] [margin:0];}
.home-hero .hero-buttons{@apply [margin:24px_0_20px];}
.home-hero .party-btn.primary span{@apply [margin-left:9px] [transition:transform_.2s];}
.home-hero .party-btn.primary:hover span{@apply [transform:translateX(4px)];}
.hero-showcase{@apply [height:440px] [position:relative] [border:9px_solid_#fff] [border-radius:38px_38px_120px_38px] [box-shadow:0_32px_70px_#7b3b5529] [transform:rotate(1deg)];}
.hero-showcase>img,.hero-image-fallback{@apply [width:100%] [height:100%] [object-fit:cover] [display:block] [border-radius:29px_29px_111px_29px];}
.hero-image-fallback{@apply [display:grid] [place-items:center] [font-size:110px] [background:linear-gradient(145deg,#ffe4ed,#fff0cb)];}
.hero-photo-shade{@apply [position:absolute] [inset:0] [border-radius:29px_29px_111px_29px] [background:linear-gradient(180deg,transparent_45%,#17223ad9)];}
.hero-photo-caption{@apply [position:absolute] [left:26px] [right:25px] [bottom:25px] [color:#fff] [display:flex] [flex-direction:column] [gap:5px];}
.hero-photo-caption span{@apply [width:max-content] [padding:5px_10px] [border-radius:20px] [background:#ff5d8f] [font-size:.68rem] [font-weight:800] [text-transform:uppercase] [letter-spacing:.08em];}
.hero-photo-caption strong{@apply [font-family:Roboto] [font-size:1.22rem] [line-height:1.25] [max-width:390px];}
.hero-rating{@apply [position:absolute] [left:-34px] [top:45px] [z-index:3] [display:flex] [align-items:center] [gap:10px] [padding:12px_15px] [border:1px_solid_#fff] [background:#ffffffed] [border-radius:16px] [box-shadow:0_15px_35px_#17223a22] [transform:rotate(-1deg)];}
.hero-rating>b{@apply [width:38px] [height:38px] [display:grid] [place-items:center] [border-radius:12px] [color:#fff] [background:linear-gradient(135deg,var(--pink),var(--orange))];}
.hero-rating span{@apply [display:flex] [flex-direction:column];}
.hero-rating strong{@apply [font-size:.78rem];}
.hero-rating small{@apply [color:var(--muted)] [font-size:.65rem] [margin-top:2px];}
.hero-service-strip{@apply [position:relative] [z-index:5] [max-width:1120px] [margin:-45px_auto_0] [padding:10px] [background:#fff] [border:1px_solid_#f5dfe5] [border-radius:24px] [box-shadow:0_18px_50px_#72364c18] [display:grid] [grid-template-columns:repeat(4,1fr)];}
.hero-service-strip>a{@apply [min-width:0] [display:flex] [align-items:center] [gap:11px] [padding:12px_14px] [border-right:1px_solid_var(--line)] [border-radius:15px] [transition:.2s];}
.hero-service-strip>a:last-child{@apply [border-right:0];}
.hero-service-strip>a:hover{@apply [background:#fff3f6];}
.hero-service-strip>a>span{@apply [flex:0_0_42px] [width:42px] [height:42px] [display:grid] [place-items:center] [border-radius:13px] [background:linear-gradient(135deg,#ffe7ef,#fff1d8)] [font-size:22px];}
.hero-service-strip div{@apply [min-width:0] [display:flex] [flex-direction:column];}
.hero-service-strip small{@apply [font-size:.62rem] [color:var(--muted)] [text-transform:uppercase] [letter-spacing:.07em];}
.hero-service-strip strong{@apply [font-size:.76rem] [white-space:nowrap] [overflow:hidden] [text-overflow:ellipsis];}
.hero-service-strip>a>b{@apply [margin-left:auto] [color:var(--pink)];}
.home-services{@apply [padding-top:0px];}
.home-services .section-heading{@apply [margin-bottom:30px];}
.home-service-grid{@apply [grid-template-columns:repeat(4,1fr)] [gap:20px];}
.home-service-card{@apply [display:block] [overflow:hidden] [border:1px_solid_var(--line)] [border-radius:23px] [background:#fff] [box-shadow:0_9px_30px_#1d34570c] [transition:transform_.25s,box-shadow_.25s];}
.home-service-card:hover{@apply [transform:translateY(-7px)] [box-shadow:0_20px_45px_#5b30461a];}
.home-service-visual{@apply [height:190px] [position:relative] [display:grid] [place-items:center] [overflow:hidden] [background:linear-gradient(145deg,#ffe9f0,#fff1d3)];}
.home-service-visual img{@apply [width:100%] [height:100%] [object-fit:cover] [transition:transform_.4s];}
.home-service-card:hover .home-service-visual img{@apply [transform:scale(1.055)];}
.home-service-visual>span{@apply [font-size:67px];}
.home-service-visual>b{@apply [position:absolute] [right:12px] [bottom:12px] [padding:6px_10px] [border-radius:20px] [background:#ffffffeb] [color:#536078] [font-size:.65rem] [box-shadow:0_5px_15px_#17223a18];}
.home-service-body{@apply [display:grid] [grid-template-columns:auto_1fr] [gap:12px] [padding:18px];}
.service-number{@apply [color:#ff9aaf] [font:800_.72rem_Roboto];}
.home-service-body h3{@apply [font-size:1.16rem] [line-height:1.16] [margin:0_0_7px];}
.home-service-body p{@apply [min-height:59px] [margin:0_0_10px] [color:var(--muted)] [font-size:.78rem] [line-height:1.5];}
.home-service-body strong{@apply [color:var(--pink)] [font-size:.75rem];}
.home-service-body strong b{@apply [display:inline-block] [margin-left:3px] [transition:transform_.2s];}
.home-service-card:hover .home-service-body strong b{@apply [transform:translateX(4px)];}
@media(max-width:1000px){
.home-hero{@apply [gap:30px] [padding-bottom:75px];}
.hero-showcase{@apply [height:390px] [max-width:650px] [width:100%] [margin:auto];}
.hero-rating{@apply [left:18px];}
.hero-service-strip{@apply [margin:-40px_24px_0] [grid-template-columns:repeat(2,1fr)];}
.hero-service-strip>a:nth-child(2){@apply [border-right:0];}
.hero-service-strip>a:nth-child(-n+2){@apply [border-bottom:1px_solid_var(--line)];}
.home-service-grid{@apply [grid-template-columns:repeat(2,1fr)];}
}
@media(max-width:720px){
.home-hero{@apply [padding:42px_20px_72px] [gap:30px];}
.home-hero .hero-copy h1{@apply [font-size:2.75rem] [line-height:.98];}
.home-hero .hero-copy>p{@apply [font-size:.95rem] [line-height:1.65];}
.home-hero .hero-buttons{@apply [display:grid];}
.home-hero .party-btn{@apply [width:100%];}
.hero-showcase{@apply [height:330px] [border-width:6px] [border-radius:25px_25px_70px_25px];}
.hero-showcase>img,.hero-image-fallback,.hero-photo-shade{@apply [border-radius:19px_19px_64px_19px];}
.hero-photo-caption{@apply [left:18px] [right:18px] [bottom:18px];}
.hero-photo-caption strong{@apply [font-size:1rem];}
.hero-rating{@apply [display:none];}
.hero-service-strip{@apply [margin:-42px_14px_0] [padding:8px] [grid-template-columns:1fr];}
.hero-service-strip>a{@apply [border-right:0] ![border-bottom:1px_solid_var(--line)];}
.hero-service-strip>a:last-child{@apply ![border-bottom:0];}
.hero-service-strip>a:nth-child(n+4){@apply [display:none];}
.home-services{@apply [padding-top:48px];}
.home-service-grid{@apply [grid-template-columns:1fr];}
.home-service-visual{@apply [height:215px];}
.home-service-body p{@apply [min-height:0];}
.home-hero .trust-row{@apply [display:grid] [grid-template-columns:1fr_1fr];}
.home-hero .trust-row span{@apply [width:auto];}
.home-hero .trust-row span:last-child{@apply [grid-column:1/-1];}
}
.navigation-wrap{@apply [max-width:1160px] [margin:0_auto] [padding:16px_24px] [display:flex] [align-items:center] [gap:18px] [flex-wrap:wrap];}
.back-button{@apply [border:1px_solid_#e2e8f0] [background:#fff] [color:#64748b] [padding:8px_13px] [border-radius:9px] [cursor:pointer] [font-weight:600];}
.back-button:hover{@apply [border-color:#0ea5e9] [color:#0ea5e9];}
.breadcrumb{@apply ![display:flex] [align-items:center] [gap:8px] [flex-wrap:wrap] [font-size:14px] [color:#64748b];}
.breadcrumb a:hover{@apply [color:#0ea5e9];}
.breadcrumb strong{@apply [color:#0f172a] [max-width:340px] [white-space:nowrap] [overflow:hidden] [text-overflow:ellipsis];}
.event-actions{@apply [display:flex] [gap:12px] [flex-wrap:wrap] [margin-top:32px] [padding-top:24px] [border-top:1px_solid_#e2e8f0];}
.btn-secondary{@apply [display:inline-block] [background:#fff] [color:#0ea5e9] [border:1px_solid_#0ea5e9] [border-radius:9px] [padding:10px_17px] [font-weight:700];}
@media(max-width:700px){
.breadcrumb{@apply ![display:flex];}
.navigation-wrap{@apply [padding:12px_16px_0] [gap:10px];}
.breadcrumb strong{@apply [max-width:190px];}
}
.category-hero{@apply [text-align:center] [padding:75px_24px] [background:linear-gradient(145deg,#fff1f5,#fff8e7_55%,#edfcff)];}
.category-hero>span{@apply [color:var(--pink)] [font-size:.78rem] [font-weight:800] [letter-spacing:.13em];}
.category-hero-name{@apply [font-family:Roboto,sans-serif] [font-size:clamp(2.3rem,5vw,4rem)] [font-weight:800] [line-height:1.08] [margin:8px_0];}
.category-page-heading{@apply [width:100%] [max-width:none] [margin:0_0_42px];}
.category-page-heading h1{@apply [margin:0_0_14px];}
.category-page-heading p{@apply [margin:0] [color:var(--muted)] [font-size:1.05rem] [line-height:1.8];}
.category-page-banner{@apply [width:100%] [margin:0_0_42px] [overflow:hidden] [border-radius:24px] [background:#f8fafc] [box-shadow:0_16px_42px_#17223a18];}
.category-page-banner img{@apply [display:block] [width:100%] [aspect-ratio:16/7] [object-fit:cover];}
.site-page-content .wrap.category-posts{@apply [width:100%] [max-width:none] [margin:0] [padding:0px_0_48px] [background:transparent] [border-radius:0];}
.category-posts>h2{@apply [margin:0_0_20px];}
.category-posts .chips+h2{@apply [margin-top:34px];}
.category-posts .post-grid{@apply [width:100%] [max-width:1000px] [grid-template-columns:repeat(3,minmax(0,1fr))];}
.category-pagination{@apply [display:flex] [align-items:center] [justify-content:center] [gap:12px] [margin-top:30px] [flex-wrap:wrap];}
.category-pagination a,.category-pagination span{@apply [min-height:42px] [display:inline-flex] [align-items:center] [justify-content:center] [padding:9px_15px] [border:1px_solid_var(--line)] [border-radius:12px] [background:#fff] [color:#46516a] [font-size:.85rem] [font-weight:800];}
.category-pagination a:hover{@apply [border-color:#ff9fbd] [background:#fff1f5] [color:var(--pink)];}
.category-pagination .page-status{@apply [border-color:#ffd7e4] [background:linear-gradient(135deg,#fff1f5,#fff8e7)] [color:#d93f70];}
.category-pagination .disabled{@apply [opacity:.5] [cursor:not-allowed];}
.category-content-blocks{@apply [max-width:none] [margin:0] [padding:0] [display:grid];}
.category-content-block{@apply [display:grid] [grid-template-columns:minmax(0,1fr)] [gap:20px] [margin-bottom:24px];}
.category-content-block>h2{@apply [margin:0];}
.category-content-block>img{@apply [display:block] [width:100%] [aspect-ratio:16/9] [object-fit:cover] [border-radius:22px] [box-shadow:0_16px_42px_#17223a18];}
.category-content-block.text-only{@apply [width:100%];}
.category-block-copy{@apply [width:100%] [max-width:none];}
.category-block-copy.prose{@apply [color:#46516a] [line-height:1.85];}
.category-block-copy.prose a{@apply [color:#2563eb] [text-decoration:none] [font-weight:700];}
.category-block-copy.prose a:hover{@apply [color:var(--pink)] [text-decoration:none];}
.category-block-copy.prose p{@apply [margin:0_0_14px];}
.category-block-copy.prose p:last-child{@apply [margin-bottom:0];}
.feature-strip{@apply [max-width:1180px] [margin:0_auto_70px] [padding:0_24px] [display:grid] [grid-template-columns:repeat(3,1fr)] [gap:18px];}
.feature-strip>div{@apply [padding:26px] [border-radius:22px] [background:linear-gradient(145deg,#fff1f5,#fff8e7)] [border:1px_solid_#ffe0e8];}
.feature-strip b{@apply [font-size:2rem];}
.feature-strip h3{@apply [margin:10px_0_5px];}
.feature-strip p{@apply [margin:0] [color:var(--muted)] [line-height:1.6];}
@media(max-width:1000px){
.category-posts .post-grid{@apply [grid-template-columns:repeat(2,minmax(0,1fr))];}
}
@media(max-width:760px){
.category-hero{@apply [padding:55px_20px];}
.category-hero-name{@apply [font-size:clamp(2rem,10vw,3rem)];}
.category-page-heading{@apply [margin-bottom:32px];}
.category-page-banner{@apply [margin-bottom:32px] [border-radius:18px];}
.category-page-banner img{@apply [aspect-ratio:16/9];}
.site-page-content .wrap.category-posts{@apply [margin:0] [padding:28px_0_38px];}
.category-posts .post-grid{@apply [grid-template-columns:minmax(0,1fr)];}
.category-pagination{@apply [display:grid] [grid-template-columns:1fr_1fr] [gap:8px];}
.category-pagination .page-status{@apply [grid-column:1/-1] [grid-row:1];}
.category-content-blocks{@apply [margin:0] [padding:0] [gap:36px];}
.category-content-block{@apply [gap:16px];}
.feature-strip{@apply [grid-template-columns:1fr];}
}
:root{@apply [--type-h1:clamp(1.75rem,_3vw,_2.25rem)] [--type-h2:clamp(1.4rem,_2.4vw,_1.8rem)] [--type-h3:clamp(1.15rem,_1.8vw,_1.35rem)] [--type-p:1rem] [--type-heading-line:1.25] [--type-copy-line:1.8];}
main h1{@apply [font-family:Roboto,_sans-serif] ![font-size:var(--type-h1)] [font-weight:400];}
main h2{@apply [font-family:Roboto,_sans-serif] [font-weight:400];}
.service-card h3,
.home-service-card h3,
.post-card h3{@apply [font-family:Roboto,_sans-serif] [font-weight:400] [display:-webkit-box] [min-height:2.5em] [line-height:1.25] [-webkit-box-orient:vertical] [-webkit-line-clamp:2] [line-clamp:2] [overflow:hidden] [text-overflow:ellipsis];}
.category-page-heading h1{@apply [font-size:var(--type-h1)] [line-height:var(--type-heading-line)];}
.category-posts > h2,
.category-content-block > h2{@apply [font-size:var(--type-h2)] [line-height:var(--type-heading-line)];}
.feature-strip h3{@apply [font-size:var(--type-h3)] [line-height:var(--type-heading-line)];}
.category-page-heading p,
.category-block-copy p,
.feature-strip p{@apply [font-size:var(--type-p)] [line-height:var(--type-copy-line)];}
@media (max-width: 760px){
:root{@apply [--type-h1:1.7rem] [--type-h2:1.35rem] [--type-h3:1.15rem] [--type-p:.96rem];}
}
.sr-only{@apply [position:absolute] [width:1px] [height:1px] [padding:0] [margin:-1px] [overflow:hidden] [clip:rect(0,0,0,0)] [white-space:nowrap] [border:0];}
.site-nav{@apply [position:relative];}
.nav-services{@apply [position:static];}
.nav-service-row{@apply [display:flex] [align-items:center];}
.main-nav .nav-service-link{@apply [padding-right:5px];}
.nav-service-toggle{@apply [display:grid] [place-items:center] [flex:none] [width:28px] [height:34px] [padding:0] [border:0] [border-radius:8px] [background:transparent] [color:#68738a] [cursor:pointer] [transition:.2s];}
.nav-service-toggle svg{@apply [display:block] [width:12px] [height:8px] [transition:transform_.2s];}
.nav-services.open .nav-service-toggle svg{@apply [transform:rotate(180deg)];}
.mega-menu{@apply [position:absolute] [top:calc(100%_-_4px)] [left:50%] [width:min(1040px,calc(100vw_-_32px))] [padding-top:18px] [opacity:0] [visibility:hidden] [pointer-events:none] [transform:translate(-50%,8px)] [transition:opacity_.18s_ease,transform_.18s_ease,visibility_.18s] [z-index:120];}
.mega-panel{@apply [overflow:hidden] [border:1px_solid_#e8edf4] [border-radius:22px] [background:#fff] [box-shadow:0_24px_65px_rgba(24,35,58,.18)];}
.mega-heading{@apply [display:flex] [align-items:center] [justify-content:space-between] [gap:24px] [padding:20px_24px] [border-bottom:1px_solid_#edf1f6] [background:linear-gradient(120deg,#fff4f7,#fffaf0_55%,#f2fcff)];}
.mega-heading>div{@apply [display:flex] [flex-direction:column];}
.mega-heading span{@apply [color:#ff5d8f] [font-size:.68rem] [font-weight:900] [letter-spacing:.12em];}
.mega-heading strong{@apply [margin-top:3px] [font-family:Roboto,sans-serif] [font-size:1.2rem];}
.main-nav .mega-heading>a{@apply [padding:8px_12px] [color:#ff5d8f] [background:#fff] [border:1px_solid_#ffd9e5] [white-space:nowrap];}
.mega-grid{@apply [display:grid] [grid-template-columns:repeat(4,minmax(0,1fr))] [gap:0] [max-height:min(520px,65vh)] [overflow:auto];}
.mega-group{@apply [min-width:0] [padding:20px_22px] [border-right:1px_solid_#edf1f6] [border-bottom:1px_solid_#edf1f6];}
.mega-group:nth-child(4n){@apply [border-right:0];}
.main-nav .mega-group-title{@apply [display:grid] [grid-template-columns:10px_minmax(0,1fr)_auto] [align-items:center] [gap:9px] [padding:0] [color:#18233a] [font-family:Roboto,sans-serif] [font-size:1rem] [line-height:1.25];}
.main-nav .mega-group-title:hover{@apply [background:transparent] [color:#ff5d8f];}
.mega-group-mark{@apply [width:9px] [height:9px] [border-radius:50%] [background:#ff5d8f] [box-shadow:0_0_0_5px_#fff0f5];}
.tone-2 .mega-group-mark{@apply [background:#ff9f43] [box-shadow:0_0_0_5px_#fff5e7];}
.tone-3 .mega-group-mark{@apply [background:#34c8d8] [box-shadow:0_0_0_5px_#e9fbfd];}
.tone-4 .mega-group-mark{@apply [background:#8b5cf6] [box-shadow:0_0_0_5px_#f0ebff];}
.tone-5 .mega-group-mark{@apply [background:#4b7bec] [box-shadow:0_0_0_5px_#ebf0ff];}
.mega-group-title b{@apply [color:#b3bdcd];}
.mega-links{@apply [display:grid] [gap:3px] [margin:10px_0_0_19px];}
.main-nav .mega-links a{@apply [display:flex] [align-items:center] [justify-content:space-between] [gap:8px] [padding:7px_8px] [color:#68738a] [font-size:.82rem] [font-weight:700];}
.main-nav .mega-links a:hover{@apply [color:#ff5d8f] [background:#fff4f7];}
.mega-links b{@apply [font-size:1rem];}
.mega-group p{@apply [margin:10px_0_0_19px] [color:#8490a5] [font-size:.77rem] [line-height:1.5];}
.main-nav .mega-direct{@apply [display:block] [margin:8px_0_0_19px] [padding:5px_0] [color:#7b879b] [font-size:.76rem];}
.main-nav .mega-direct:hover{@apply [background:transparent] [color:#ff5d8f];}
.mega-empty{@apply [grid-column:1/-1] [padding:30px] [text-align:center] [color:#68738a];}
@media(min-width:721px){
.nav-services:hover .mega-menu,.nav-services:focus-within .mega-menu,.nav-services.open .mega-menu{@apply [opacity:1] [visibility:visible] [pointer-events:auto] [transform:translate(-50%,0)];}
.nav-services:hover .nav-service-toggle svg,.nav-services:focus-within .nav-service-toggle svg{@apply [transform:rotate(180deg)];}
}
@media(max-width:900px) and (min-width:721px){
.mega-grid{@apply [grid-template-columns:repeat(3,minmax(0,1fr))];}
.mega-group:nth-child(4n){@apply [border-right:1px_solid_#edf1f6];}
.mega-group:nth-child(3n){@apply [border-right:0];}
}
@media(max-width:720px){
.nav-services{@apply [width:100%];}
.nav-service-row{@apply [width:100%];}
.main-nav .nav-service-link{@apply [flex:1];}
.nav-service-toggle{@apply [width:44px];}
.mega-menu{@apply [position:static] [width:100%] [padding:0] [display:none] [opacity:1] [visibility:visible] [pointer-events:auto] [transform:none] [transition:none];}
.nav-services.open .mega-menu{@apply [display:block];}
.mega-panel{@apply [margin:4px_0_8px] [border-radius:13px] [box-shadow:none] [background:#fbfcfe];}
.mega-heading{@apply [padding:14px];}
.mega-heading strong{@apply [font-size:1rem];}
.main-nav .mega-heading>a{@apply [display:none];}
.mega-grid{@apply [display:grid] [grid-template-columns:1fr] [max-height:52vh];}
.mega-group,.mega-group:nth-child(4n){@apply [padding:14px_16px] [border-right:0];}
.main-nav .mega-group-title{@apply [font-size:.95rem];}
.mega-links{@apply [margin-left:19px];}
.main-nav .mega-links a{@apply [padding:8px];}
.main-nav>a{@apply [width:100%];}
}
@media(prefers-reduced-motion:reduce){
.mega-menu,.nav-service-toggle svg{@apply [transition:none];}
}
.site-header{@apply [position:sticky] [top:0] [z-index:300];}
.site-nav{@apply [max-width:1440px];}
.main-nav{@apply [min-width:0];}
.nav-category{@apply [position:relative];}
.nav-category-row{@apply [display:flex] [align-items:center];}
.main-nav .nav-category-link{@apply [max-width:150px] [padding:9px_5px_9px_9px] [overflow:hidden] [text-overflow:ellipsis] [white-space:nowrap] [font-size:.8rem];}
.nav-category-toggle{@apply [display:grid] [place-items:center] [flex:none] [width:24px] [height:32px] [padding:0] [border:0] [border-radius:7px] [background:transparent] [color:#68738a] [cursor:pointer];}
.nav-category-toggle svg{@apply [width:11px] [height:7px] [transition:transform_.2s];}
.nav-category.open .nav-category-toggle svg{@apply [transform:rotate(180deg)];}
.nav-category-dropdown{@apply [position:absolute] [top:calc(100%_-_3px)] [left:0] [display:grid] [width:250px] [padding:9px] [border:1px_solid_#e8edf4] [border-radius:14px] [background:#fff] [box-shadow:0_18px_45px_#18233a26] [opacity:0] [visibility:hidden] [pointer-events:none] [transform:translateY(4px)] [transition:.18s] [z-index:320];}
.main-nav .nav-category-dropdown a{@apply [display:flex] [align-items:center] [justify-content:space-between] [gap:10px] [padding:9px_10px] [color:#59657b] [font-size:.8rem];}
.main-nav .nav-category-dropdown a:hover{@apply [color:var(--pink)] [background:#fff1f5];}
.main-nav .nav-category-dropdown .nav-category-all{@apply [color:#18233a] [font-weight:900] [border-bottom:1px_solid_#edf1f6] [border-radius:8px_8px_0_0];}
@media(min-width:1101px){
.nav-category:hover .nav-category-dropdown,.nav-category:focus-within .nav-category-dropdown,.nav-category.open .nav-category-dropdown{@apply [opacity:1] [visibility:visible] [pointer-events:auto] [transform:none];}
.nav-category:hover .nav-category-toggle svg,.nav-category:focus-within .nav-category-toggle svg{@apply [transform:rotate(180deg)];}
}
@media(max-width:1240px) and (min-width:1101px){
.site-nav{@apply [padding:0_14px];}
.main-nav{@apply [gap:1px];}
.main-nav>a{@apply [padding-left:7px] [padding-right:7px];}
.main-nav .nav-category-link{@apply [max-width:105px] [padding-left:6px] [font-size:.74rem];}
.nav-contact{@apply ![font-size:0];}
.nav-contact::first-letter{@apply [font-size:1rem];}
}
@media(max-width:1100px){
.menu-button{@apply [display:block];}
.main-nav{@apply [display:none] [position:absolute] [top:76px] [left:12px] [right:12px] [max-height:calc(100vh_-_92px)] [overflow:auto] [background:#fff] [padding:10px] [border-radius:15px] [box-shadow:0_15px_40px_#26375028] [flex-direction:column] [align-items:stretch];}
.main-nav.open{@apply [display:flex];}
.main-nav>a,.nav-category{@apply [width:100%];}
.nav-category-row{@apply [width:100%];}
.main-nav .nav-category-link{@apply [flex:1] [max-width:none] [padding:10px_13px] [font-size:.9rem];}
.nav-category-toggle{@apply [width:44px];}
.nav-category-dropdown{@apply [position:static] [display:none] [width:100%] [padding:5px_8px_8px] [margin:2px_0_7px] [opacity:1] [visibility:visible] [pointer-events:auto] [transform:none] [box-shadow:none] [background:#f8fafc];}
.nav-category.open .nav-category-dropdown{@apply [display:grid];}
.main-nav .nav-category-dropdown a{@apply [padding:9px_12px];}
.main-nav>a{@apply [padding:10px_13px];}
.main-nav .nav-contact{@apply [text-align:center];}
.site-header{@apply [height:76px];}
}
@media(max-width:720px){
.main-nav{@apply [top:66px] [max-height:calc(100vh_-_80px)];}
.site-header{@apply [height:66px];}
}
.main-nav>a,.main-nav .nav-category-link{@apply [font-size:14.4px];}
.main-nav>a.active,.nav-category.active .nav-category-link{@apply [color:var(--pink)] [background:#fff1f5];}
.nav-category.active .nav-category-toggle{@apply [color:var(--pink)] [background:#fff1f5];}
.main-nav .nav-category-dropdown a.active{@apply [color:var(--pink)] [background:#fff1f5];}
@media(max-width:1240px) and (min-width:1101px){
.main-nav .nav-category-link{@apply [font-size:14.4px];}
.main-nav .nav-contact{@apply ![font-size:14.4px];}
}
.product-price{@apply [display:flex] [align-items:center] [gap:8px] [flex-wrap:wrap] [margin:13px_0_15px] [padding:8px] [border-radius:11px] [background:linear-gradient(135deg,#fff1f5,#fff8ed)] [border:1px_solid_#ffe0e8];}
.price-label{@apply [font-size:.78rem] [color:#64748b] [font-weight:700];}
.product-price del{@apply [color:#94a3b8] [font-size:.82rem];}
.price-current,.price-contact{@apply [color:#e11d63] [font-size:1.05rem] [font-weight:900];}
.price-discount{@apply [padding:3px_7px] [border-radius:20px] [background:#e11d63] [color:#fff] [font-size:.68rem] [font-weight:900];}
.post-image-more{@apply [position:absolute] [right:14px] [bottom:14px] [z-index:2] [padding:7px_11px] [border-radius:20px] [background:#17223ad9] [color:#fff] [font-size:.72rem] [font-weight:900] [line-height:1] [box-shadow:0_6px_18px_#17223a38] [transition:.2s];}
.post-image:hover .post-image-more{@apply [background:var(--pink)] [transform:translateY(-2px)];}
.floating-contact .float-zalo{@apply [background:#0878f9] [font-family:Roboto,sans-serif] [font-size:.68rem] [letter-spacing:-.03em];}
body{@apply [padding-top:68px] [background:radial-gradient(circle_at_8%_12%,#ffdce8_0,transparent_25%),radial-gradient(circle_at_92%_18%,#fff0c9_0,transparent_27%),linear-gradient(145deg,#fff9f5_0%,#fff_54%,#fff5ec_100%)] [background-attachment:fixed];}
.site-header{@apply ![position:fixed] [top:0] [right:0] [left:0] [width:100%] [height:68px] [z-index:500];}
.site-page-shell{@apply [display:grid] [grid-template-columns:280px_minmax(0,1fr)] [align-items:start] [gap:24px] [width:calc(100%_-_48px)] [max-width:1180px] [margin:0_auto] [padding:0_0_60px];}
.site-page-content{@apply [min-width:0] [margin-top:16px] [padding:0_24px_32px] [border:1px_solid_#f1dbe2] [border-radius:18px] [background:rgba(255,255,255,.72)] [box-shadow:0_8px_28px_rgba(74,35,50,.05)];}
.home-hero{@apply [padding-top:0];}
.site-page-content>.party-section,.site-page-content>.wrap,.site-page-content>.article{@apply [padding-top:0] [padding-right:0] [padding-left:0];}
.site-page-content .navigation-wrap{@apply [width:100%] [max-width:none] [margin:0] [padding:16px_0];}
.site-page-content .feature-strip{@apply [padding-right:0] [padding-left:0];}
.service-sidebar{@apply [padding:16px_0_42px];}
.service-sidebar-inner{@apply [position:sticky] [top:84px] [max-height:calc(100vh_-_100px)] [overflow:auto] [border:1px_solid_var(--line)] [border-radius:15px] [background:#fff] [box-shadow:0_8px_26px_#17223a0b];}
.service-sidebar-heading{@apply [display:flex] [flex-direction:column] [padding:17px_16px] [background:linear-gradient(135deg,#fff1f5,#fff8ed)] [border-bottom:1px_solid_#ffe4eb];}
.service-sidebar-heading span{@apply [color:var(--pink)] [font-size:.72rem] [font-weight:900] [letter-spacing:.12em];}
.service-sidebar-heading strong{@apply [margin-top:3px] [font-family:Roboto,sans-serif] [font-size:1.22rem] [line-height:1.3];}
.service-sidebar-nav{@apply [display:grid] [padding:9px];}
.service-sidebar-nav a{@apply [text-decoration:none];}
.service-sidebar-parent{@apply [display:flex] [align-items:center] [justify-content:space-between] [gap:10px] [padding:11px_12px] [border-radius:10px] [color:#334155] [font-size:.9rem] [font-weight:800] [line-height:1.45];}
.service-sidebar-parent span{@apply [display:grid] [gap:1px];}
.service-sidebar-parent small{@apply [color:#94a3b8] [font-size:.66rem] [font-weight:700];}
.service-sidebar-parent:hover,.service-sidebar-group.active>.service-sidebar-parent{@apply [color:var(--pink)] [background:#fff1f5];}
.service-sidebar-children{@apply [display:grid] [margin:2px_0_8px_13px] [padding-left:11px] [border-left:2px_solid_#f1f5f9];}
.service-sidebar-children a{@apply [display:grid] [gap:2px] [padding:8px_9px] [border-radius:8px] [color:#68738a] [font-size:.82rem] [font-weight:700] [line-height:1.4];}
.service-sidebar-children a span{@apply [display:-webkit-box] [-webkit-box-orient:vertical] [-webkit-line-clamp:2] [line-clamp:2] [overflow:hidden];}
.service-sidebar-children time{@apply [color:#a1aabd] [font-size:.68rem] [font-weight:500];}
.service-sidebar-children a:hover,.service-sidebar-children a.active{@apply [color:var(--pink)] [background:#fff7fa];}
.service-sidebar-empty{@apply [margin:8px] [padding:12px] [color:#64748b] [font-size:.82rem] [text-align:center];}
.site-page-content .contact-banner{@apply [margin-left:0] [margin-right:0];}
@media(max-width:1200px) and (min-width:901px){
.site-page-shell{@apply [grid-template-columns:245px_minmax(0,1fr)] [gap:20px];}
.main-nav{@apply [top:68px];}
.service-sidebar-parent{@apply [font-size:.84rem];}
.service-sidebar-children a{@apply [font-size:.78rem];}
}
@media(max-width:900px){
.site-page-shell{@apply [display:block] [width:calc(100%_-_40px)] [padding-bottom:40px];}
.service-sidebar{@apply [padding:10px_0_0];}
.service-sidebar-inner{@apply [position:static] [max-height:none];}
.service-sidebar-heading{@apply [padding:11px_13px];}
.service-sidebar-nav{@apply [display:flex] [gap:7px] [overflow-x:auto] [padding:7px];}
.service-sidebar-parent{@apply [white-space:nowrap] [margin:0];}
.service-sidebar-group{@apply [flex:none];}
.service-sidebar-children{@apply [display:none];}
.site-page-content{@apply [margin-top:12px] [padding:0_16px_24px] [border-radius:14px];}
.site-page-content .navigation-wrap{@apply [margin:0] [padding:12px_0];}
.site-page-content .contact-banner{@apply [margin-left:0] [margin-right:0];}
}
@media(max-width:720px){
body{@apply [padding-top:62px];}
.site-header{@apply [height:62px];}
.main-nav{@apply [top:62px];}
}
.event-listing{@apply [padding-top:34px];}
.event-filter-card{@apply [margin:24px_0_36px] [padding:24px] [border:1px_solid_#e8edf4] [border-radius:22px] [background:linear-gradient(135deg,#fff_0%,#fff9fb_60%,#fffaf3_100%)] [box-shadow:0_14px_40px_rgba(29,52,87,.08)];}
.event-filter-heading{@apply [display:flex] [align-items:center] [justify-content:space-between] [gap:24px] [margin-bottom:18px];}
.event-filter-heading>div:first-child{@apply [display:flex] [flex-direction:column];}
.event-filter-heading>div:first-child>span{@apply [color:#ff5d8f] [font-size:.7rem] [font-weight:900] [letter-spacing:.13em];}
.event-filter-heading h2{@apply [margin:3px_0_0] [font-size:1.45rem] [line-height:1.2];}
.event-result-count{@apply [display:flex] [align-items:center] [gap:9px] [padding:9px_13px] [border:1px_solid_#ffdbe6] [border-radius:13px] [background:#fff] [color:#68738a] [white-space:nowrap];}
.event-result-count strong{@apply [color:#e83e74] [font-family:Roboto,sans-serif] [font-size:1.25rem] [line-height:1];}
.event-result-count span{@apply [font-size:.76rem] [font-weight:700];}
.event-filters{@apply [display:grid] [grid-template-columns:minmax(260px,1fr)_minmax(190px,240px)_auto_auto] [gap:11px] [align-items:center];}
.event-filter-search,.event-filter-select{@apply [position:relative] [display:block];}
.event-filter-search input,.event-filter-select select{@apply [width:100%] [height:48px] [border:1.5px_solid_#e1e7ef] [border-radius:13px] [background:#f8fafc] [color:#334155] [font:inherit] [font-size:.88rem] [outline:0] [transition:.18s];}
.event-filter-search input{@apply [padding:0_15px_0_43px];}
.event-filter-select select{@apply [padding:0_38px_0_14px] [cursor:pointer];}
.event-filter-search input::placeholder{@apply [color:#9ba6b7];}
.event-filter-search input:focus,.event-filter-select select:focus{@apply [border-color:#ff719d] [background:#fff] [box-shadow:0_0_0_4px_rgba(255,93,143,.11)];}
.event-filter-icon{@apply [position:absolute] [left:15px] [top:50%] [z-index:1] [transform:translateY(-52%)] [color:#94a3b8] [font-size:1.35rem] [line-height:1];}
.event-filter-submit,.event-filter-reset{@apply [height:48px] [display:inline-flex] [align-items:center] [justify-content:center] [gap:7px] [padding:0_18px] [border-radius:13px] [font:inherit] [font-size:.84rem] [font-weight:900] [white-space:nowrap] [cursor:pointer];}
.event-filter-submit{@apply [border:0] [color:#fff] [background:linear-gradient(135deg,#ff5d8f,#ff8b5f)] [box-shadow:0_9px_22px_rgba(255,93,143,.25)];}
.event-filter-submit:hover{@apply [transform:translateY(-1px)] [box-shadow:0_12px_26px_rgba(255,93,143,.32)];}
.event-filter-reset{@apply [border:1.5px_solid_#e1e7ef] [background:#fff] [color:#68738a];}
.event-filter-reset:hover{@apply [border-color:#ffb0c8] [color:#e83e74] [background:#fff7fa];}
.active-filters{@apply [display:flex] [align-items:center] [gap:7px] [flex-wrap:wrap] [margin-top:14px] [color:#8490a5] [font-size:.76rem];}
.active-filters>b{@apply [padding:5px_9px] [border-radius:999px] [background:#fff0f5] [color:#d93268] [font-weight:800];}
.event-results{@apply [margin-top:0];}
.event-results+.pagination{@apply [margin-top:28px];}
.event-results .empty-state a{@apply [color:#e83e74] [font-weight:800];}
.sr-only{@apply [position:absolute] [width:1px] [height:1px] [padding:0] [margin:-1px] [overflow:hidden] [clip:rect(0,0,0,0)] [white-space:nowrap] [border:0];}
@media(max-width:950px){
.event-filters{@apply [grid-template-columns:1fr_1fr];}
.event-filter-search{@apply [grid-column:1/-1];}
.event-filter-submit,.event-filter-reset{@apply [width:100%];}
}
@media(max-width:620px){
.event-listing{@apply [padding-top:20px];}
.event-filter-card{@apply [margin:16px_0_28px] [padding:17px] [border-radius:17px];}
.event-filter-heading{@apply [align-items:flex-start] [margin-bottom:15px];}
.event-filter-heading h2{@apply [font-size:1.15rem];}
.event-result-count{@apply [padding:7px_9px];}
.event-result-count span{@apply [display:none];}
.event-filters{@apply [grid-template-columns:1fr] [gap:9px];}
.event-filter-search{@apply [grid-column:auto];}
.event-filter-search input,.event-filter-select select,.event-filter-submit,.event-filter-reset{@apply [height:46px];}
.active-filters{@apply [margin-top:12px];}
}
.article{@apply [max-width:920px] [padding:32px_24px_64px];}
.article>h1{@apply [font-size:clamp(1.9rem,4vw,3.1rem)] [line-height:1.12] [letter-spacing:-.025em] [margin:0_0_8px];}
.article>.meta{@apply [margin:0_0_22px] [line-height:1.6];}
.article h2{@apply [font-size:clamp(1.45rem,2.8vw,2rem)] [line-height:1.25] [margin:38px_0_16px];}
.article>.cover{@apply [margin:14px_0_24px];}
.article .event-content .prose a{@apply ![color:#2563eb] ![text-decoration:none] ![border-bottom:0] [font-weight:700];}
.article .event-content .prose a:hover{@apply ![color:var(--pink)];}
.event-content,.event-gallery,.event-followup{@apply [margin-top:34px];}
.event-gallery{@apply [display:grid] [gap:24px];}
.event-gallery h2{@apply [margin-bottom:-4px];}
.event-gallery figure{@apply [width:100%] [margin:0] [padding:0];}
.event-gallery figure .cover{@apply [display:block] [width:100%] [height:auto] [max-height:none] [object-fit:contain] [margin:0] [border-radius:18px];}
.event-gallery figure h3{@apply [font-size:clamp(1.2rem,2.2vw,1.55rem)] [margin:0_0_10px];}
.event-image-content{@apply [color:#46516a] [line-height:1.85] [margin-top:14px];}
.event-image-content a{@apply ![color:#2563eb] ![text-decoration:none] [font-weight:700];}
.event-followup{@apply [padding-top:2px] [border-top:1px_solid_var(--line)];}
.event-followup .prose{@apply [color:#46516a] [line-height:1.85];}
@media(max-width:720px){
.article{@apply [padding:24px_18px_48px];}
.article>h1{@apply [font-size:clamp(1.85rem,9vw,2.35rem)];}
.article h2{@apply [margin-top:30px];}
}

}
